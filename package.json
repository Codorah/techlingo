{
  "name": "techlingo",
  "version": "1.0.0",
  "private": true,
  "description": "TechLingo — apprendre l'anglais technique (PWA + apps Android/iOS via Capacitor)",
  "scripts": {
    "dev": "serve www -l 8080",
    "start": "serve www -l 8080",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor #2B6CB0 --iconBackgroundColorDark #2B6CB0 --splashBackgroundColor #EAF6FF --splashBackgroundColorDark #0F2238",
    "sync": "cap sync",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "serve": "^14.2.6"
  }
}
