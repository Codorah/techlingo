{
  "name": "techlingo",
  "version": "1.0.0",
  "private": true,
  "description": "TechLingo — apprendre l'anglais technique (PWA + apps Android/iOS via Capacitor)",
  "scripts": {
    "dev": "npm run app:dev",
    "start": "npm run app:build:drafts && vite preview --port 8080",
    "legacy": "serve www -l 8081",
    "app:dev": "npm run content:build -- --drafts && vite --port 8080",
    "app:build": "npm run content:build && vite build",
    "app:build:drafts": "npm run content:build -- --drafts && vite build",
    "app:preview": "vite preview",
    "content:validate": "tsx scripts/content/validate.ts",
    "content:build": "tsx scripts/content/build.ts",
    "content:stats": "tsx scripts/content/validate.ts --stats",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor #2B6CB0 --iconBackgroundColorDark #2B6CB0 --splashBackgroundColor #EAF6FF --splashBackgroundColorDark #0F2238",
    "sync": "cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "content:import": "tsx scripts/content/import.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@neondatabase/serverless": "^1.2.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "i18next": "^26.5.12",
    "lucide-react": "^1.66.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "ts-fsrs": "^6.0.0",
    "web-push": "^3.6.7",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
